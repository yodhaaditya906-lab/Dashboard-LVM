{
  "version": 2,
  "builds": [
    {
      "src": "api/data.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "config.json",
      "use": "@vercel/static"
    },
    {
      "src": "data.csv",
      "use": "@vercel/static"
    },
    {
      "src": "data_september.csv",
      "use": "@vercel/static"
    },
    {
      "src": "data_agustus.csv",
      "use": "@vercel/static"
    },
    {
      "src": "bg-galaxy.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/data",
      "dest": "/api/data.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
